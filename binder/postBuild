#!/usr/bin/env bash

# Download ERA5 data
DATA_DIR="$HOME/input/"
mkdir -p "$DATA_DIR"
wget -r -nd --no-parent -A EA* -R index.html -P "$DATA_DIR" https://webdata.wolke.img.univie.ac.at/scratch/ERA5/

# Ensure the cache directory exists
mkdir -p "${CARTOPY_DATA_DIR}"

# Pre-fetch Natural Earth features at desired scales
python - <<'PY'
import cartopy.feature as cfeature

features = [
    cfeature.LAND,
    cfeature.OCEAN,
    cfeature.COASTLINE,
    cfeature.BORDERS,
    cfeature.LAKES,
]

scales = ['110m']

# Force download by constructing per-scale features and touching geometries()
for base in features:
    for scale in scales:
        try:
            f = base.with_scale(scale)
            # Accessing geometries triggers the download into CARTOPY_DATA_DIR
            list(f.geometries())
            print(f"Cached {getattr(base, 'name', str(base))} at {scale}")
        except Exception as e:
            print(f"Warning: could not cache {getattr(base, 'name', str(base))} at {scale}: {e}")
PY

# does not work
# update-alternatives --install /usr/bin/gfortran gfortran /usr/bin/gfortran-14 100
mkdir -p "$HOME/.local/bin"
ln -sf /usr/bin/gfortran-14 "$HOME/.local/bin/gfortran"
# Variables
cat >> $HOME/.bashrc <<'EOF'
# Add local bin to PATH
export PATH="$HOME/.local/bin:$PATH"
export CPATH="/srv/conda/envs/notebook/include:$CPATH"
export LIBRARY_PATH="/srv/conda/envs/notebook/lib:$LIBRARY_PATH"
export FC=gfortran-14
EOF